# Copia este archivo como ".env" (sin .example) y completa los valores
GEMINI_API_KEY=pega_aqui_tu_clave
GEMINI_MODEL=gemini-2.5-flash
# Código que se pide al abrir la app (déjalo vacío solo si lo usas en tu PC)
ACCESS_CODE=cambia-este-codigo
# Límite diario de mensajes a la IA, para proteger tu cuota gratuita
MAX_MENSAJES_DIA=400
PORT=3000
